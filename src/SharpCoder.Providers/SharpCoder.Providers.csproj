<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet Package Properties -->
    <IsPackable>true</IsPackable>
    <PackageId>SharpCoder.Providers</PackageId>
    <VersionPrefix>0.16.1</VersionPrefix>
    <Authors>Rob</Authors>
    <Description>Model-provider infrastructure for SharpCoder: IChatClient factories for GitHub Copilot, GitHub Models and Ollama, with resilience, reasoning-effort mapping and opt-in diagnostics.</Description>
    <PackageTags>ai;agent;llm;copilot;ollama;openai;providers</PackageTags>
    <RepositoryUrl>https://github.com/robkaandorp/SharpCoder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpCoder.Providers.Tests" />
    <InternalsVisibleTo Include="CopilotHive.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

</Project>

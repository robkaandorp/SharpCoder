<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only process fixture. It is deliberately tiny: a console app used by
    tests/SharpCoder.Tests to create a real root -> child -> grandchild process tree with
    recorded identities and a deterministic readiness rendezvous. It is never packaged and
    takes no package dependencies.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SharpCoder.ProcessFixture</AssemblyName>
    <RootNamespace>SharpCoder.ProcessFixture</RootNamespace>
    <UseAppHost>true</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>

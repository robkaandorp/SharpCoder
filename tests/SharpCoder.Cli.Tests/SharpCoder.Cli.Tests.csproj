<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The CLI targets net11.0 and is deliberately not in SharpCoder.slnx (CI builds with the .NET 10 SDK).
         This test project likewise stays out of the solution and CI; run it explicitly with
         `dotnet test tests/SharpCoder.Cli.Tests` on a machine with the .NET 11 SDK. -->
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SharpCoder.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCoder.Cli\SharpCoder.Cli.csproj" />
  </ItemGroup>

</Project>
